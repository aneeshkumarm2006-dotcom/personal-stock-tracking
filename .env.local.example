MONGODB_URI=mongodb+srv://...
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=
CRON_SECRET=
APP_AUTH_SECRET=
RESEARCH_API_TOKEN=

# indianapi.in API key — powers company fundamentals on the Research page.
# Get a free key at https://indianapi.in. Server-only; never NEXT_PUBLIC_.
INDIANAPI_KEY=

# Watchlist price-alert emails (Gmail SMTP, self-to-self — no third-party API).
# Requires 2-Step Verification enabled on the Google account and a 16-char
# App Password (NOT your normal Gmail password). Left blank, alerts still fire
# in-app; only the email send is skipped.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: recipient(s). Comma-separated for multiple, e.g.
# ALERT_EMAIL_TO=me@gmail.com,dad@gmail.com,partner@outlook.com
# Defaults to GMAIL_USER when left blank.
ALERT_EMAIL_TO=
# Optional: base URL used for the "View in app" link in alert emails.
APP_BASE_URL=

# Web Push (browser/OS notifications for strategy SL/TP hits — fire even when the
# site is closed). Generate a key pair once with:  npx web-push generate-vapid-keys
# Set the same pair locally and in your Vercel env. VAPID_SUBJECT is a contact
# mailto: URL. Left blank, SL/TP hits still show in-app + email; only push is
# skipped.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
